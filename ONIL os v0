# ============================================================
#  USER SYSTEM
# ============================================================

def create_account():
    print("== CREATE ACCOUNT ==")
    while True:
        username = input("NEW USERNAME: ")
        if username in users:
            print("USERNAME ALREADY EXISTS.")
            return
        password = input("NEW PASSWORD: ")
        if len(password) >= 3:
            break
        print("PASSWORD TOO SHORT.")

    users[username] = {
        "password": hash_password(password),
        "role": "user",
        "clearance": "SECRET"
    }
    save_json(USERS_DB, users)
    slow_print("ACCOUNT SUCCESSFULLY CREATED.")

def login():
    attempt = 3
    while attempt > 0:
        print("== LOGIN ==")
        username = input("USERNAME: ")
        password = input("PASSWORD: ")

        if username in users and users[username]["password"] == hash_password(password):
            print("AUTHENTICATING...")
            time.sleep(0.3)
            print("== ACCESS GRANTED ==")
            return username, users[username]["role"], users[username]["clearance"]

        attempt -= 1
        print(f"WRONG CREDENTIALS. {attempt} ATTEMPTS LEFT.")

    print("ACCESS DENIED.")
    return None, None, None

def list_users():
    print("== USERS ==")
    if not users:
        print("NO USERS FOUND.")
        return
    for index, username in enumerate(users, start=1):
        print(f"{index}. {username} ({users[username]['role'].upper()})")

def edit_user():
    print("== EDIT USER ==")
    username = input("USERNAME TO EDIT: ")

    if username not in users:
        print("USER NOT FOUND.")
        return

    new_username = input("NEW USERNAME (BLANK = SAME): ")
    new_password = input("NEW PASSWORD (BLANK = SAME): ")

    if new_username:
        users[new_username] = users.pop(username)
        username = new_username

    if new_password:
        users[username]["password"] = hash_password(new_password)

    save_json(USERS_DB, users)
    print("USER UPDATED.")

def delete_user():
    print("== DELETE USER ==")
    username = input("USERNAME TO DELETE: ")

    if username not in users:
        print("USER NOT FOUND.")
        return
    if users[username]["role"] == "admin":
        print("CANNOT DELETE ADMIN.")
        return

    del users[username]
    save_json(USERS_DB, users)
    print("USER DELETED.")

# ============================================================
#  FILE SYSTEM
# ============================================================

def create_file(current_user):
    print("== CREATE FILE ==")
    filename = input("FILE NAME: ")

    if current_user not in files:
        files[current_user] = {}

    if filename in files[current_user]:
        print("FILE ALREADY EXISTS.")
        return

    content = input("FILE CONTENT: ")
    files[current_user][filename] = content
    save_json(FILES_DB, files)
    print("FILE CREATED.")

def read_file(current_user):
    print("== READ FILE ==")
    filename = input("FILE NAME: ")

    if current_user not in files or filename not in files[current_user]:
        print("FILE NOT FOUND.")
        return

    print("== FILE CONTENT ==")
    print(files[current_user][filename])


def edit_files(current_user):
    print("== EDIT FILE ==")
    filename = input("ENTER FILENAME: ")

    # Check if user has files and if file exists
    if current_user not in files or filename not in files[current_user]:
        print("FILE NOT FOUND.")
        return

    # Show current content
    print("== CURRENT CONTENT ==")
    print(files[current_user][filename])

    # Get new content
    new_content = input("ENTER NEW CONTENT: ")

    # Save changes
    files[current_user][filename] = new_content
    save_json(FILES_DB, files)

    print("FILE UPDATED.")

  
def delete_file(current_user):
    print("== DELETE FILE ==")
    filename = input("FILE NAME: ")

    if current_user not in files or filename not in files[current_user]:
        print("FILE NOT FOUND.")
        return

    del files[current_user][filename]
    save_json(FILES_DB, files)
    print("FILE DELETED.")

def list_files(current_user):
    print("== YOUR FILES ==")
    if current_user not in files or not files[current_user]:
        print("NO FILES FOUND.")
        return
    for index, filename in enumerate(files[current_user], start=1):
        print(f"{index}. 📁 {filename}")

def list_all_files():
    print("== ALL USER FILES ==")
    if not files:
        print("NO FILES FOUND.")
        return
    for user, user_files in files.items():
        print(f"\nUSER: {user}")
        if not user_files:
            print("  NO FILES.")
            continue
        for filename in user_files:
            print(f"  📁 {filename}")

