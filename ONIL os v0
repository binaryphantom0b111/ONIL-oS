def create_files(current_user):
  print("== CREATE FILE == ")
  filename = input("ENTER FILENAME: _")
  if current_user not in files:
    files[current_user] = {}
    
  if filename in files[current_user]:
    print("FILENAME ALREADY EXIST ")
    return

  content = input("ENTER FILE CONTENT: _")
  files[current_user][filename] = content
  save_json(FILES_DB, files)
  print("FILE SUCCESSFULLY CREATED ")

def open_file(current_user):
