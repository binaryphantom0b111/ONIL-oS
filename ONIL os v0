                print("8. ADMIN PANEL")

            choice = input("CHOOSE: ").strip()

            if choice == "0":
                print("LOGGING OUT...")
                current_user = None
                role = None
                clearance = None

            elif choice == "1":
                create_file(current_user)

            elif choice == "2":
                read_file(current_user)
            elif choice == "3":
                edit_files(current_user)

            elif choice == "4":
                delete_file(current_user)

            elif choice == "5":
                list_files(current_user)

            elif choice == "6":
                list_users()

            elif choice == "7":
                delete_user()

            elif choice == "8":
                edit_user()

            elif choice == "9" and role == "admin":
                admin_panel(current_user)

